<?xml version="1.0" encoding="utf-8"?>
<ir.tapsell.mediation.ad.views.ntv.NativeAdViewContainer xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tapsell_native_ad_container"
    android:layout_width="match_parent"
    android:background="#ffffff"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        android:layout_margin="2dp"
        app:cardElevation="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/tapsell_native_ad_media"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="#EEEEEE" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/tapsell_native_ad_logo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#EEEEEE"
                    android:contentDescription="Ad Icon"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/tapsell_native_ad_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:textColor="#333333"
                    android:fontFamily="@font/font_medium"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tapsell_native_ad_description"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:textSize="12sp"
                    android:fontFamily="@font/font_regular"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/tapsell_native_ad_cta"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:background="@drawable/btn_ads_background"
                    android:fontFamily="@font/font_medium"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>
</ir.tapsell.mediation.ad.views.ntv.NativeAdViewContainer>
