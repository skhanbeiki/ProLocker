<?xml version="1.0" encoding="utf-8"?>
<ir.tapsell.mediation.ad.views.ntv.NativeAdViewContainer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tapsell_native_ad_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="#ffffff">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tapsell_native_ad_logo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="#EEEEEE"
            android:layout_marginEnd="8dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tapsell_native_ad_title"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/font_medium"
                android:textColor="#333333"
                android:gravity="center_vertical"
                android:textSize="12sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/tapsell_native_ad_cta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_ads_background"
                android:fontFamily="@font/font_medium"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>




    </LinearLayout>

<!--    <com.adivery.sdk.AdiveryNativeAdMediaView-->
<!--        android:id="@+id/tapsell_native_ad_media"-->
<!--        android:layout_width="0dp"-->
<!--        android:layout_height="0dp"-->
<!--        android:visibility="gone" />-->

</ir.tapsell.mediation.ad.views.ntv.NativeAdViewContainer>
