<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adivery_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="#efedde">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">


        <ImageView
            android:id="@+id/adivery_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:background="#EEEEEE"
            android:contentDescription="Ad Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/adivery_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:fontFamily="@font/font_medium"
                android:textStyle="bold"
                android:textColor="#333333" />

<!--            <TextView-->
<!--                android:id="@+id/adivery_description"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:fontFamily="@font/font_regular"-->
<!--                android:textSize="12sp"-->
<!--                android:textColor="#666666"-->
<!--                android:visibility="gone" />-->

<!--            <TextView-->
<!--                android:id="@+id/adivery_advertiser"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:fontFamily="@font/font_regular"-->
<!--                android:textSize="10sp"-->
<!--                android:textColor="#999999"-->
<!--                android:visibility="gone" />-->
        </LinearLayout>

        <Button
            android:id="@+id/adivery_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/btn_ads_background"
            android:fontFamily="@font/font_medium"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginStart="8dp"
            android:text="INSTALL"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <com.adivery.sdk.AdiveryNativeAdMediaView
        android:id="@+id/adivery_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>
